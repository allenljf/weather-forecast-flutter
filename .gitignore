# --- API token ---------------------------------------------------------------
# `reviewer.json` is deliberately committed: it holds a free, disposable CWA
# token so reviewers can run the app without registering. See README.
# Any other file here is treated as a real secret and stays out of git.
dart_defines/*.json
!dart_defines/reviewer.json
!dart_defines/*.example.json

# --- Flutter / Dart ----------------------------------------------------------
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.log

# Coverage
coverage/

